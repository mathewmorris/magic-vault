generator client {
    provider = "prisma-client-js"
    previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id              String  @id
  name            String
  scryfall_uri    String
  image_status    String
  image_uris      Json?   @db.JsonB
  card_faces      Json?   @db.JsonB
  all_parts       Json?   @db.JsonB
  layout          String

  // Gameplay and printing fields from Scryfall's card object
  // (https://scryfall.com/docs/api/cards). All nullable: older rows stay
  // empty until the next bulk sync fills them in.
  oracle_id        String?
  mana_cost        String?
  cmc              Float?
  type_line        String?
  oracle_text      String?
  power            String?
  toughness        String?
  loyalty          String?
  colors           Json?   @db.JsonB
  color_identity   Json?   @db.JsonB
  keywords         Json?   @db.JsonB
  set              String?
  set_name         String?
  collector_number String?
  rarity           String?
  artist           String?
  flavor_text      String?
  released_at      String?
  legalities       Json?   @db.JsonB
  finishes         Json?   @db.JsonB
  lang             String?

  // Scryfall's prices object (usd, usd_foil, usd_etched, eur, ...; values are
  // decimal strings or null) and purchase_uris. Refreshed by the daily sync.
  prices           Json?   @db.JsonB
  purchase_uris    Json?   @db.JsonB

  @@index([oracle_id])
  @@index([set, collector_number])
  // Trigram indexes for the "contains" searches on /search. The pg_trgm
  // extension is created in the migration that adds them.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([oracle_text(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Collection {
    id            String   @id @default(cuid())
    name          String?   @default("My Collection")
    // Legacy list of card ids (duplicates meant multiples). Copied into
    // CardsOnCollections and no longer read; safe to drop in a later migration.
    cards         String[]
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
    user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId        String
    deletedAt       DateTime?
    cardEntries   CardsOnCollections[]
}

// One row per card in a collection, with how many copies are in it.
// cardId is deliberately not a foreign key to Card (same as the old
// String[] column): the seed wipes and reloads the Card table, and that
// shouldn't fail or empty people's collections. Ids that don't match a
// card are skipped when reading.
model CardsOnCollections {
    collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    collectionId  String
    cardId        String
    // Which printing finish these copies are: "nonfoil", "foil" or "etched".
    // Part of the key, so a foil and a non-foil copy are separate entries.
    finish        String     @default("nonfoil")
    count         Int        @default(1)
    createdAt     DateTime   @default(now())
    updatedAt     DateTime   @updatedAt

    @@id([collectionId, cardId, finish])
}

// Necessary for Next auth
model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    collections   Collection[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}
