generator client {
    provider = "prisma-client-js"
    previewFeatures = ["driverAdapters", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector, for card image embeddings (AI card recognition). Neon has it
  // built in; local and homelab Postgres use the pgvector/pgvector image.
  extensions = [vector]
}

model Card {
  id              String  @id
  name            String
  scryfall_uri    String
  image_status    String
  image_uris      Json?   @db.JsonB
  card_faces      Json?   @db.JsonB
  all_parts       Json?   @db.JsonB
  layout          String

  // Gameplay and printing fields from Scryfall's card object
  // (https://scryfall.com/docs/api/cards). All nullable: older rows stay
  // empty until the next bulk sync fills them in.
  oracle_id        String?
  mana_cost        String?
  cmc              Float?
  type_line        String?
  oracle_text      String?
  power            String?
  toughness        String?
  loyalty          String?
  colors           Json?   @db.JsonB
  color_identity   Json?   @db.JsonB
  keywords         Json?   @db.JsonB
  set              String?
  set_name         String?
  collector_number String?
  rarity           String?
  artist           String?
  flavor_text      String?
  released_at      String?
  legalities       Json?   @db.JsonB
  finishes         Json?   @db.JsonB
  lang             String?

  // How the printing looks, for telling printings of one card apart (the AI
  // scanner's colour cues, src/utils/recognition/colourCues.ts). Scryfall
  // leaves frame_effects and promo_types out when there are none, so those
  // two are stored as empty lists rather than null.
  border_color     String?
  frame            String?
  frame_effects    String[] @default([])
  promo_types      String[] @default([])
  security_stamp   String?
  // Top level only: cards whose faces have their own art keep theirs in card_faces.
  illustration_id  String?

  // Prices live in CardPrice, so a nightly price move doesn't rewrite the
  // whole Card row.

  // Scryfall's purchase_uris. Refreshed by the daily sync.
  purchase_uris    Json?   @db.JsonB
  price            CardPrice?
  embeddings       CardEmbedding[]

  @@index([oracle_id])
  @@index([set, collector_number])
  // Trigram indexes for the "contains" searches on /search. The pg_trgm
  // extension is created in the migration that adds them.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([oracle_text(ops: raw("gin_trgm_ops"))], type: Gin)
}

// Scryfall's prices object for one card (usd, usd_foil, usd_etched, eur,
// ...; values are decimal strings or null). Its own table because prices
// change every day and the rest of the card almost never does: the nightly
// sync rewrites these small rows instead of ~2 KB Card rows. Goes with the
// card when the card is deleted.
model CardPrice {
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String   @id
  prices    Json?    @db.JsonB
  updatedAt DateTime @default(now())
}

// Image embedding of one card face, for AI card recognition. Built by
// scripts/embed-cards.ts from Scryfall's "normal" image. modelId is
// EMBED_MODEL.id (src/utils/recognition/model.ts): a new model or new
// preprocessing gets a new id, so old and new vectors are never compared.
// Unlike CardsOnCollections this IS a foreign key: an embedding of a card
// that's gone is useless, so it goes with the card.
model CardEmbedding {
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  // Index into card_faces for cards whose faces have their own images
  // (transform, modal_dfc, ...); 0 for everything else.
  face      Int      @default(0)
  modelId   String
  embedding Unsupported("halfvec(256)")
  createdAt DateTime @default(now())

  @@id([cardId, face, modelId])
  @@index([modelId])
}

model Collection {
    id            String   @id @default(cuid())
    name          String?   @default("My Collection")
    // Legacy list of card ids (duplicates meant multiples). Copied into
    // CardsOnCollections and no longer read; safe to drop in a later migration.
    cards         String[]
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
    user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId        String
    deletedAt       DateTime?
    cardEntries   CardsOnCollections[]
}

// One row per card in a collection, with how many copies are in it.
// cardId is deliberately not a foreign key to Card (same as the old
// String[] column): the seed wipes and reloads the Card table, and that
// shouldn't fail or empty people's collections. Ids that don't match a
// card are skipped when reading.
model CardsOnCollections {
    collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    collectionId  String
    cardId        String
    // Which printing finish these copies are: "nonfoil", "foil" or "etched".
    // Part of the key, so a foil and a non-foil copy are separate entries.
    finish        String     @default("nonfoil")
    count         Int        @default(1)
    // Condition of these copies: "NM", "LP", "MP", "HP" or "DMG". Not part
    // of the key; an import that adds to an existing entry keeps its value.
    condition     String     @default("NM")
    // Scryfall language code of these copies, like "en" or "ja".
    language      String     @default("en")
    createdAt     DateTime   @default(now())
    updatedAt     DateTime   @updatedAt

    @@id([collectionId, cardId, finish])
}

model Deck {
    id            String    @id @default(cuid())
    name          String
    // A format key from Scryfall's legalities ("commander", "modern", ...).
    format        String    @default("commander")
    description   String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId        String
    deletedAt     DateTime?
    cardEntries   CardsOnDecks[]

    @@index([userId])
}

// One row per card per board in a deck, with how many copies are on it.
// Like CardsOnCollections, cardId is deliberately not a foreign key to Card
// so reloading the Card table never fails or empties decks. board is one of
// "main", "side" or "commander".
model CardsOnDecks {
    deck          Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
    deckId        String
    cardId        String
    count         Int       @default(1)
    board         String    @default("main")
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    @@id([deckId, cardId, board])
}

// Necessary for Next auth
model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    collections   Collection[]
    decks         Deck[]
    achievements  UserAchievement[]
}

// Achievements a user has earned. The keys live in
// src/utils/achievements/achievements.ts.
model UserAchievement {
    userId    String
    key       String
    earnedAt  DateTime @default(now())
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([userId, key])
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}
