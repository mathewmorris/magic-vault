# Optional: affiliate buy links. Off unless AFFILIATE_LINKS is "on". While off,
# buy links use Scryfall's own store links. Each ID is optional.
AFFILIATE_LINKS="off"
# TCGplayer tracking link from Impact, like https://partner.tcgplayer.com/c/<account>/<ad>/21018
TCGPLAYER_AFFILIATE_URL=""
# Card Kingdom partner ID (letters, digits, _ and -)
CARDKINGDOM_PARTNER_ID=""

# Card search asks Scryfall when a name has no local match. Set to "off" to
# keep searches local (no network). Off by default under Jest.
# SCRYFALL_FALLBACK=off
