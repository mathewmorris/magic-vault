# Copy to .env.homelab on bananajuice and fill in the two secrets.
# .env.homelab is gitignored. Never commit it.

# Make one with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://magicvault.internal

# Pick a password and use the same one in both lines.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://magic_vault:PASSWORD_HERE@db:5432/magic_vault

# Sign-in links go to Mailpit, which shows them at http://mailpit.internal.
# For public v1, point EMAIL_SERVER at a real sending service instead.
EMAIL_SERVER=smtp://mailpit:1025
EMAIL_FROM=noreply@mathewmorris.com

# Optional. Each OAuth provider turns on only when both of its values are set,
# and its app needs http://magicvault.internal/api/auth/callback/<provider>
# added as a redirect URL. Google won't accept a .internal address.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GITHUB_ID=
# GITHUB_SECRET=
